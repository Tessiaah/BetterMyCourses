{
  "name": "better-mycourses",
  "version": "1.12.2",
  "private": true,
  "type": "module",
  "description": "A privacy-friendly, inky black theme for Aalto MyCourses.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postbuild": "npm run verify:package",
    "postzip": "npm run verify:package",
    "verify:package": "node scripts/verify-extension.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:browser": "playwright test extension.spec.ts",
    "test:install": "playwright test install-smoke.spec.ts",
    "test:theme": "playwright test theme.spec.ts course-regression.spec.ts course-navigation.spec.ts course-chrome.spec.ts course-tables.spec.ts quiz-controls.spec.ts quiz-timer.spec.ts study-assist.spec.ts formulas.spec.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "bootstrap": "^5.3.8",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "katex": "0.19.0"
  }
}
